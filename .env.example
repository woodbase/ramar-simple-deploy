# ==================================================
# APP CONFIGURATION
# ==================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com


# ==================================================
# GITHUB CONFIGURATION
# ==================================================

# GitHub repository owner (username or organization)
GITHUB_OWNER=your-github-username

# Repository name
GITHUB_REPO=your-repository-name

# Branch to deploy
GITHUB_BRANCH=main

# Personal Access Token (repo read access)
# Required scope: repo (read-only is sufficient)
GITHUB_TOKEN=github_pat_your_token_here


# ==================================================
# DEPLOY CONFIGURATION
# ==================================================

# Absolute path where the code should be deployed
LOCAL_PATH=/absolute/path/to/local/files #(Current version 1.0.0 only supports moving files locally on server)

# Temporary folder for zip download and extraction
DEPLOY_TMP_PATH=/path/to/deploy-tmp

# Remove existing files before deploy (true/false)
DEPLOY_CLEAN=true


# ==================================================
# FTP CONFIGURATION
# ==================================================

# FTP or SFTP host
FTP_HOST=example.com

# FTP port (21 for FTP, 22 for SFTP)
FTP_PORT=21

# FTP username
FTP_USER=username@example.com

# FTP password
FTP_PASS=your_password_here

# Remote path on FTP server
FTP_PATH=/

